PAPERLESS_DB_PASS=my_secure_db_password
PAPERLESS_URL=https://my_paperless_domain.com
PAPERLESS_ADMIN_PASS=my_secure_admin_password
PAPERLESS_KEY=a_long_random_string
NOTIFICATION_URLS=generic+http://ipaddr:port/api/push/token?status=down&msg=backup%20failed
DOCKER_BACKUP
DOCKER_BACKUP=/bin/sh -c 'wget -q -T 10 -O /dev/null "http://ipaddr:port/api/push/token?status=up&msg=backup+ok&ping=" || true'